rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) 
        && data.uid == request.auth.uid
        && data.email is string
        && (data.role == 'admin' || data.role == 'buyer')
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is string);
    }

    function isValidPurchase(data) {
      return data.keys().hasAll(['title', 'buyerId', 'type', 'status'])
        && data.title is string && data.title.size() <= 200
        && data.buyerId == request.auth.uid
        && data.type in ['local', 'international']
        && data.status in ['draft', 'pending_proforma', 'pending_approval', 'ordered', 'delivered', 'invoiced', 'completed']
        && (!data.keys().hasAny(['totalAmount']) || data.totalAmount is number)
        && (!data.keys().hasAny(['createdAt']) || data.createdAt == request.time);
    }

    function isValidDocument(data) {
      return data.keys().hasAll(['type', 'reference'])
        && data.type in ['proforma', 'delivery_note', 'final_invoice']
        && data.reference is string && data.reference.size() <= 100
        && (!data.keys().hasAny(['amount']) || data.amount is number);
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidUser(incoming()) && incoming().role == 'buyer'; 
      allow update: if isSignedIn() && isOwner(userId) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName'])
        && isValidUser(incoming());
    }

    match /purchases/{purchaseId} {
      allow get: if isSignedIn() && (isAdmin() || existing().buyerId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || (resource.data.buyerId == request.auth.uid));
      allow create: if isSignedIn() && isValidId(purchaseId) && isValidPurchase(incoming());
      allow update: if isSignedIn() && (isAdmin() || (existing().buyerId == request.auth.uid))
        && incoming().buyerId == existing().buyerId
        && isValidPurchase(incoming())
        && (
          isAdmin() || 
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'type', 'status', 'supplier', 'totalAmount', 'items', 'updatedAt'])
        );
      allow delete: if isAdmin();

      match /documents/{docId} {
        allow read: if isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/purchases/$(purchaseId)).data.buyerId == request.auth.uid);
        allow write: if isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/purchases/$(purchaseId)).data.buyerId == request.auth.uid)
          && isValidId(docId) && isValidDocument(incoming());
      }

      match /payments/{paymentId} {
        allow read: if isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/purchases/$(purchaseId)).data.buyerId == request.auth.uid);
        allow write: if isAdmin(); // Only admins record payments
      }
    }
  }
}
